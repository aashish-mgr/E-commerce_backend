# Copy to .env and fill in. Never commit the filled-in file.
# Every variable below is validated at startup by src/config/env.ts — the
# process refuses to boot if one is missing or malformed.

# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
# Port to bind. Hosts such as Render, Railway and Fly inject this at runtime;
# leave it unset there and their value is used.
PORT=3000

# ---- Required secrets ----------------------------------------------------
# Rotate every value below before the first production deploy, especially the
# database password: these were present in this repository's git history.
DATABASE_URL=
JWT_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
KHALTI_SECRET_KEY=

# ---- Public URLs ---------------------------------------------------------
# The browser origin. Comma-separate to allow several, e.g. a staging host.
# Drives CORS, the OAuth return trip and Khalti return_url / website_url.
CLIENT_URL=http://localhost:5173
# Must be registered as an authorised redirect URI in Google Cloud, otherwise
# sign-in fails after the redirect.
GOOGLE_REDIRECT_URL=http://localhost:3000/auth/google/callback
# Khalti gateway. Defaults to the test API, and to the live API when
# NODE_ENV=production. Set explicitly only to override.
# KHALTI_API_BASE=https://web-api.khalti.com/api/v2

# ---- Transport and cookies ----------------------------------------------
# Leave unset to follow NODE_ENV, which sets Secure in production and not in
# development. Set only when the transport disagrees with NODE_ENV.
# This also picks the cookie SameSite: None (with Secure) when true, Lax when
# false. None is required whenever the frontend and API are on different sites,
# since a Lax cookie is not sent cross-site. Browsers reject None without
# Secure, so true is not a valid combination on a plaintext origin.
# COOKIE_SECURE=true
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=20d

# ---- Database ------------------------------------------------------------
# disable | require | verify-full. Unset follows NODE_ENV: verify-full in
# production. 'require' does not verify the server certificate, so an active
# attacker can still read every row, hashes and refresh tokens included.
DB_SSL_MODE=require
# PEM bundle for a private CA, if the server presents one the system trust
# store does not contain.
# DB_SSL_CA=
DB_SLOW_QUERY_MS=500
# Logs every statement with its bound values, which includes password hashes
# and tokens. Startup is refused if this is on when NODE_ENV=production.
DB_LOG_QUERIES=false

# ---- Cache ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_CONNECT_TIMEOUT_MS=3000
# Exit instead of serving uncached when Redis is unreachable.
REDIS_REQUIRED=false